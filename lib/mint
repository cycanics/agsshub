#!/usr/bin/env bash
# mint — the operator's half of the claim registry; bin/hub-mint runs it as root on the hub. The daemon
# observes what it writes (docs/hub.md): a held follow of a key or name this ends, ends at once.
# Binds an identity whose role is operator-minted (ROLES in common.sh) to one ed25519 key.
# No registrar can mint these, so each has exactly one claim, filed under claims/$OP_MINTER/.
#
#   mint add <identity> [--ttl SECONDS] [--replace] [--instances|--no-instances]   (ssh-ed25519 pubkey on stdin)
#   mint rm  <identity>
#   mint list
set -uo pipefail
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SELF_DIR/common.sh"
umask 027                                # records must be group-readable by the daemon (group hub)
M="$OP_MINTER"
[ -d "$CLAIMS/$M" ] || { echo "hub-mint: $CLAIMS/$M is missing — run install.sh" >&2; exit 1; }
mkdir -p "$BYFPR" "$TMPD" "$SERIALD" 2>/dev/null || true

serial_path(){ printf '%s/%s__%s' "$SERIALD" "$M" "$(fs_name "$1")"; }

# op_ident <identity> [enrolment] — the identity if it is operator-minted, else exit 2/3.
# A pinned one names its workspace itself; with "enrolment", that workspace must be enrolled
# for the identity's org.
op_ident(){
  local i="${1:-}" why
  why="$(ident_problem "$i")"; [ -z "$why" ] || { echo "hub-mint: $why" >&2; exit 2; }
  id_split "$i"; role_row "$ID_ROLE"
  case "$ROLE_MINTER" in
    operator) : ;;
    hub) echo "hub-mint: role $ID_ROLE is the hub's own; it cannot be claimed" >&2; exit 3 ;;
    *)   echo "hub-mint: role $ID_ROLE is minted by its workspace's registrar" >&2; exit 3 ;;
  esac
  if inst_split "$i"; then
    echo "hub-mint: $i is an instance of $INST_PARENT: the holder of that address registers it (docs/identities.md, Instances)" >&2; exit 3
  fi
  if [ "${2:-}" = enrolment ] && [ "$ROLE_SHAPE" = pinned ]; then
    ws_may_claim_org "$ID_WS" "$ID_ORG" || {
      echo "hub-mint: $ID_WS is not enrolled for org $ID_ORG (hub-enroll)" >&2; exit 3; }
  fi
  printf '%s' "$i"
}

do_add(){
  local fq; fq="$(op_ident "${1:-}" enrolment)" || exit $?
  shift || true
  id_split "$fq"
  local ttl="$OP_TTL_SECS" replace=0 inst=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ttl)     ttl="${2:-}"; shift 2 ;;
      --replace) replace=1; shift ;;
      --instances)    inst=1; shift ;;
      --no-instances) inst=0; shift ;;
      *) echo "hub-mint: unexpected arg '$1'" >&2; exit 2 ;;
    esac
  done
  [[ $ttl =~ ^[0-9]+$ ]] && [ "$ttl" -ge 60 ] || { echo "hub-mint: --ttl must be at least 60 seconds" >&2; exit 2; }
  role_row "$ID_ROLE"
  [ "$inst" != 1 ] || [ "$ROLE_INST" = no ] ||
    { echo "hub-mint: role $ID_ROLE takes no instances: its +<instance> is part of its name" >&2; exit 3; }

  local ktype kblob _rest
  read -r ktype kblob _rest || true
  [ "${ktype:-}" = ssh-ed25519 ] && [ -n "${kblob:-}" ] || { echo "hub-mint: need an ssh-ed25519 pubkey on stdin" >&2; exit 2; }

  local keyid fpr now exp dest rel sp other old_keyid="" serial rebind=0 old_inst=0
  keyid="$(keyid_from_blob "$kblob")"; fpr="$(ssh_fpr "$ktype" "$kblob")"
  [ -n "$fpr" ] || { echo "hub-mint: not a valid ssh-ed25519 key" >&2; exit 2; }
  now="$(now_epoch)"; exp=$((now+ttl))
  dest="$(claim_path "$fq" "$M")"; rel="../$M/$(fs_name "$fq")"; sp="$(serial_path "$fq")"

  claims_lock || { echo "hub-mint: registry busy; retry" >&2; exit 1; }
  if other="$(claim_live_elsewhere "$fq" "$M")"; then
    echo "claim-conflict: $fq is live from $other — a second live claim would be split brain" >&2; exit 1
  fi
  if other="$(key_bound_elsewhere "$keyid" "$rel")"; then
    echo "hub-mint: key already bound to $other" >&2; exit 1
  fi

  if [ -e "$dest" ]; then
    old_keyid="$(rec_get keyid "$dest")"; [ "$(rec_get instances "$dest")" = 1 ] && old_inst=1
    if [ "$old_keyid" = "$keyid" ]; then
      serial="$(rec_get serial "$dest")"                         # same key: renew
    elif [ "$replace" = 1 ]; then
      rebind=1; serial=$(( $(cat "$sp" 2>/dev/null || echo 0) + 1 ))
    else
      echo "claim-conflict: $fq is bound to $(rec_get fpr "$dest"); --replace rebinds it" >&2; exit 1
    fi
  else
    serial=$(( $(cat "$sp" 2>/dev/null || echo 0) + 1 ))
  fi

  # Instance capability stays as it was unless the flag says otherwise.
  [ -n "$inst" ] || inst="$old_inst"
  # A rebind evicts the old key first, so there is no moment when both keys are admitted.
  local tmp="$TMPD/mint.$$.$RANDOM"
  { printf 'name=%s\norg=%s\nws=%s\nfq=%s\ntype=%s\nblob=%s\nkeyid=%s\nfpr=%s\nmode=%s\nserial=%s\nregistered=%s\nexpires=%s\n' \
      "$ID_NAME" "$ID_ORG" "$M" "$fq" "$ktype" "$kblob" "$keyid" "$fpr" persistent "$serial" "$now" "$exp"
    [ "$inst" = 0 ] || printf 'instances=1\n'; } > "$tmp" \
    || { rm -f "$tmp"; echo "hub-mint: cannot write the registry" >&2; exit 1; }
  [ "$rebind" = 1 ] && rm -f "$BYFPR/$old_keyid"
  mv -f "$tmp" "$dest" 2>/dev/null || { rm -f "$tmp"; echo "hub-mint: cannot write $dest" >&2; exit 1; }
  ln -sfn "$rel" "$BYFPR/$keyid"
  printf '%s\n' "$serial" > "$sp"
  journal "mint $fq $fpr serial=$serial ttl=$ttl${old_keyid:+ rebind=$rebind} instances=$inst"
  # the instances the old key's holder registered, or all of them once the address takes none
  { [ "$rebind" = 1 ] || [ "$inst" = 0 ]; } && evict_instances "$fq"
  echo "minted $fq fpr=$fpr serial=$serial expires=$(iso_time "$exp")$([ "$inst" = 0 ] || printf ' instances')"
}

do_rm(){
  local fq dest keyid; fq="$(op_ident "${1:-}")" || exit $?
  dest="$(claim_path "$fq" "$M")"
  [ -e "$dest" ] || { echo "hub-mint: no such identity: $fq" >&2; exit 3; }
  claims_lock || { echo "hub-mint: registry busy; retry" >&2; exit 1; }
  keyid="$(rec_get keyid "$dest")"
  [ "$(readlink "$BYFPR/$keyid" 2>/dev/null)" = "../$M/$(fs_name "$fq")" ] && rm -f "$BYFPR/$keyid"
  rm -f "$dest" "$DESCRIBED/$(fs_name "$fq")"
  journal "unmint $fq"
  evict_instances "$fq"
  echo "released $fq"
}

do_list(){
  shopt -s nullglob
  local rec found=0
  for rec in "$CLAIMS/$M"/*; do
    [ -f "$rec" ] || continue
    echo "$(rec_get fq "$rec") serial=$(rec_get serial "$rec") fpr=$(rec_get fpr "$rec") expires=$(iso_time "$(rec_get expires "$rec")")$([ "$(rec_get instances "$rec")" != 1 ] || printf ' instances')"
    found=1
  done
  [ "$found" = 1 ] || echo "(no operator-minted identities)"
}

verb="${1:-}"; shift || true
case "$verb" in
  add)    do_add "$@" ;;
  rm)     do_rm "$@" ;;
  list)   do_list ;;
  *) echo "usage: hub-mint add <identity> [--ttl SECONDS] [--replace] [--instances|--no-instances] < key.pub | rm <identity> | list" >&2; exit 2 ;;
esac
